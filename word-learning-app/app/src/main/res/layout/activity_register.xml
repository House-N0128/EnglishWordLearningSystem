<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="24dp"
            android:layout_marginTop="40dp"
            android:elevation="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="单词学习平台 - 用户注册"
                android:textSize="22sp"
                android:textColor="#3577ef"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tv_auto_account"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="请输入手机号后自动生成账号"
                android:textSize="16sp"
                android:textColor="#8eaac4"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:singleLine="true" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="登录密码"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="密码强度：至少6位，字母+数字"
                android:textSize="13sp"
                android:textColor="#8eaac4"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_confirm_pw"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="确认密码"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="用户昵称"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp"
                android:singleLine="true" />

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="联系电话"
                android:inputType="phone"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="8dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="手机号：11位数字，用于生成账号"
                android:textSize="13sp"
                android:textColor="#8eaac4"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="邮箱地址"
                android:inputType="textEmailAddress"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="8dp"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="邮箱：如 xxx@xxx.com"
                    android:textSize="13sp"
                    android:textColor="#8eaac4" />

                <Button
                    android:id="@+id/btn_verify_email"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="验证邮箱"
                    android:textSize="12sp"

                    android:background="@drawable/bg_btn_blue_round"
                    android:textColor="#ffffff" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_email_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:padding="8dp"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/cb_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我已阅读并同意《用户服务协议》"
                    android:textSize="14sp"
                    android:textColor="#273245" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#d93025"
                android:padding="12dp"
                android:gravity="center"
                android:visibility="gone"
                android:background="#fff5f5"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#1b8a2e"
                android:padding="12dp"
                android:gravity="center"
                android:visibility="gone"
                android:background="#f0fff0"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="注册"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="12dp"
                android:elevation="4dp" />

            <Button
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="返回登录"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green"
                android:elevation="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号问题咨询"
                android:textSize="14sp"
                android:textColor="#3577ef" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" | "
                android:textSize="14sp"
                android:textColor="#8eaac4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="隐私政策"
                android:textSize="14sp"
                android:textColor="#3577ef" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
