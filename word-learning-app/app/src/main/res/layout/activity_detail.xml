<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f7fa">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#318af8"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/toolbar_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#fff"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="单词详情"
            android:textSize="18sp"
            android:textColor="#fff"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 单词标题 -->
            <TextView
                android:id="@+id/tv_word_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="mock"
                android:textSize="28sp"
                android:textColor="#318af8"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 内容卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:elevation="2dp">

                <!-- 英文拼写 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="英文拼写"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_spelling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="mock"
                    android:textSize="16sp"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="16dp" />

                <!-- 中文释义 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中文释义"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_definition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="模拟；仿真"
                    android:textSize="16sp"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="16dp" />

                <!-- 音标 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音标"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_phonetic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="/mɒk/"
                    android:textSize="16sp"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="16dp" />

                <!-- 例句 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="例句"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_example"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The test is a mock exam to prepare students."
                    android:textSize="16sp"
                    android:textColor="#2c3e50"
                    android:layout_marginBottom="16dp" />

                <!-- 单词音频 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单词音频"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="▶ 点击播放"
                    android:textSize="16sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_blue_round"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginBottom="16dp" />

                <!-- 示意图 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="示意图"
                    android:textSize="14sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/iv_word_image"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:background="#e8e8e8"
                    android:contentDescription="Word Image" />

            </LinearLayout>

            <!-- 收藏按钮 -->
            <Button
                android:id="@+id/btn_collect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⭐ 收藏单词"
                android:textSize="16sp"
                android:textColor="#fff"
                android:background="@drawable/bg_btn_green"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
