<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f2f8fc">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#318af8"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="加载中..."
            android:textSize="18sp"
            android:textColor="#fff"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="退出"
            android:textSize="14sp"
            android:textColor="#fff"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="26dp">

                <LinearLayout
                    android:id="@+id/card_today"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#fff"
                    android:padding="15dp"
                    android:layout_marginRight="7dp"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日学习" android:textSize="14sp" android:textColor="#6578a0" />
                    <TextView android:id="@+id/tv_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="20sp" android:textColor="#318af8" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="词" android:textSize="12sp" android:textColor="#8899aa" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#fff"
                    android:padding="15dp"
                    android:layout_marginLeft="7dp"
                    android:layout_marginRight="7dp"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="累计学习" android:textSize="14sp" android:textColor="#6578a0" />
                    <TextView android:id="@+id/tv_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="20sp" android:textColor="#318af8" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="词" android:textSize="12sp" android:textColor="#8899aa" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#fff"
                    android:padding="15dp"
                    android:layout_marginLeft="7dp"
                    android:gravity="center"
                    android:elevation="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="当前词书" android:textSize="12sp" android:textColor="#6578a0" />
                    <TextView android:id="@+id/tv_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="#318af8" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Recommended Books -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="推荐词书" android:textSize="17sp" android:textColor="#318af8" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:id="@+id/book_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp" />

            <!-- Recent Words -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="最近学习" android:textSize="16sp" android:textColor="#318af8" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:id="@+id/recent_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="#fff"
        android:elevation="8dp"
        android:gravity="center">

        <TextView android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🏠\n首页" android:textSize="13sp" android:textColor="#17c2ae" android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/nav_books" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📚\n词书浏览" android:textSize="13sp" android:textColor="#318af8" android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/nav_search" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔍\n单词查询" android:textSize="13sp" android:textColor="#318af8" android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/nav_collect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⭐\n我的收藏" android:textSize="13sp" android:textColor="#318af8" android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/nav_records" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📝\n学习记录" android:textSize="13sp" android:textColor="#318af8" android:gravity="center" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="👤\n个人中心" android:textSize="13sp" android:textColor="#318af8" android:gravity="center" android:clickable="true" android:focusable="true" />

    </LinearLayout>
</LinearLayout>
