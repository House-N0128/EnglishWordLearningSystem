<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f7ff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2196F3"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="24sp"
                android:textColor="#fff"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="单词学习"
                android:textSize="20sp"
                android:textColor="#fff"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- 学习内容标题 -->
        <TextView
            android:id="@+id/tv_study_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学习 - 英语四级词书"
            android:textSize="20sp"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp" />

        <!-- 单词卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#fff"
            android:padding="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <!-- 单词和音频按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="effective"
                    android:textSize="28sp"
                    android:textColor="#2196F3"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_audio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:background="#E3F2FD"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="播放音频" />

                <TextView
                    android:id="@+id/tv_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="adj."
                    android:textSize="16sp"
                    android:textColor="#2196F3"
                    android:layout_marginLeft="12dp" />
            </LinearLayout>

            <!-- 音标 -->
            <TextView
                android:id="@+id/tv_phonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[/'fektɪv/]"
                android:textSize="16sp"
                android:textColor="#666"
                android:layout_marginTop="8dp" />

            <!-- 中文释义 -->
            <TextView
                android:id="@+id/tv_chinese"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有效的"
                android:textSize="16sp"
                android:textColor="#333"
                android:layout_marginTop="8dp" />

            <!-- 例句 -->
            <TextView
                android:id="@+id/tv_example"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="例句：This medicine is very effective against the flu."
                android:textSize="14sp"
                android:textColor="#666"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- 第一行按钮：收藏单词 + 上一个 + 下一个 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_collect"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="收藏单词"
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_blue_round"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="上一个"
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_blue_round"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginLeft="10dp" />

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="下一个"
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_blue_round"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <!-- 第二行按钮：标记已掌握 -->
            <Button
                android:id="@+id/btn_mastered"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="标记已掌握"
                android:textSize="14sp"
                android:textColor="#fff"
                android:background="@drawable/bg_btn_blue_round"
                android:layout_marginTop="12dp" />

            <!-- 进度条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progressDrawable="@android:drawable/progress_horizontal" />

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 6 个/ 总 6 个单词"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 完成学习按钮 -->
            <Button
                android:id="@+id/btn_finish"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="完成学习"
                android:textSize="14sp"
                android:textColor="#fff"
                android:background="@drawable/bg_btn_blue_round"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
