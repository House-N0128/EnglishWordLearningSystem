<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f9fc">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#318af8"
        android:padding="0dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="词书浏览"
            android:textSize="20sp"
            android:textColor="#fff"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 标题文字和我的词书按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="词书浏览"
            android:textSize="18sp"
            android:textColor="#318af8"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_my_books"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="查看我的已学词书"
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:background="@drawable/bg_btn_mywordbooks"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 筛选和搜索区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinner_difficulty"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_input"
            android:padding="10dp" />

        <EditText
            android:id="@+id/et_search_book"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.6"
            android:layout_marginLeft="12dp"
            android:hint="词书名称搜索"
            android:textSize="14sp"
            android:textColor="#333"
            android:textColorHint="#999"
            android:background="@drawable/bg_input"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_search_book"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="0.8"
            android:layout_marginLeft="12dp"
            android:text="搜索"
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>



    <!-- 内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/book_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- 示例卡片1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/book_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="英语四级词书"
                    android:textSize="18sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/book_info_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="中级 | 1200词"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/book_time_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创建时间: 2025-01-01"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_study_1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="开始学习"
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp" />
            </LinearLayout>

            <!-- 示例卡片2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/book_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="雅思进阶词书"
                    android:textSize="18sp"
                    android:textColor="#318af8"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/book_info_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="高级 | 1890词"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/book_time_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="创建时间: 2025-02-05"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_study_2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="开始学习"
                    android:textSize="14sp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="#fff"
        android:gravity="center"
        android:elevation="8dp">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏠\n首页"
            android:textSize="13sp"
            android:textColor="#318af8"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_books"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📚\n词书浏览"
            android:textSize="13sp"
            android:textColor="#17c2ae"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍\n单词查询"
            android:textSize="13sp"
            android:textColor="#318af8"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_collection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐\n我的收藏"
            android:textSize="13sp"
            android:textColor="#318af8"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_records"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📝\n学习记录"
            android:textSize="13sp"
            android:textColor="#318af8"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤\n个人中心"
            android:textSize="13sp"
            android:textColor="#318af8"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
